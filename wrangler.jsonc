{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aetherwebsite",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-03-20",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "0ad443f4c3de4e41b3ef8bdc23b42321"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  }
}
