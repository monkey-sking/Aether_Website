---
import "../styles/global.css";
import "../styles/premium-overrides.css";
import { getLangFromUrl } from "../i18n/utils";
import { languages } from "../i18n/ui";
import Analytics from "../components/Analytics.astro";
import { getSiteCopy } from "../data/siteCopy";

interface Props {
  title: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const copy = getSiteCopy(lang);
const { title, description = copy.meta.defaultDescription } = Astro.props;

function getLocalizedPath(targetLang: string) {
  let path = Astro.url.pathname;
  if (path.length > 1 && path.endsWith("/")) path = path.slice(0, -1);

  const otherLangs = Object.keys(languages).filter((item) => item !== "en");
  const currentLangPrefix = otherLangs.find((item) => path.startsWith(`/${item}/`) || path === `/${item}`);

  if (currentLangPrefix) {
    if (targetLang === "en") {
      const next = path.replace(`/${currentLangPrefix}`, "");
      return next || "/";
    }
    return path.replace(`/${currentLangPrefix}`, `/${targetLang}`);
  }

  if (targetLang === "en") return path;
  return path === "/" ? `/${targetLang}/` : `/${targetLang}${path}`;
}

const langUrls = Object.keys(languages).reduce((acc, code) => {
  acc[code] = getLocalizedPath(code);
  return acc;
}, {} as Record<string, string>);

const homePath = lang === "zh-hans" ? "/zh-hans/" : "/";
const navItems = [
  [copy.nav.pricing, `${homePath}pricing`],
  [copy.nav.faq, `${homePath}faq`],
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {copy.meta.siteName}</title>

    <!-- SEO Verifications (Uncomment and fill with tokens when available) -->
    <!-- <meta name="google-site-verification" content="GOOGLE_TOKEN_HERE" /> -->
    <!-- <meta name="msvalidate.01" content="BING_TOKEN_HERE" /> -->
    <!-- <meta name="baidu-site-verification" content="BAIDU_TOKEN_HERE" /> -->

    <Analytics />
  </head>
  <body>
    <div class="site-bg">
      <div class="orb orb-a"></div>
      <div class="orb orb-b"></div>
      <div class="orb orb-c"></div>
    </div>

    <header class="site-header">
      <div class="container masthead">
        <a href={homePath} class="brand">
          <img src="/logo-clean.png" alt="Aether Logo" />
        </a>

        <nav class="site-nav">
          <a href={homePath}>{copy.nav.home}</a>
          {navItems.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
        </nav>

        <div class="header-tools">
          <select
            class="lang-select"
            onchange="localStorage.setItem('manual-lang', 'true'); window.location.href = this.value"
            aria-label="Language"
          >
            {Object.entries(languages).map(([code, label]) => (
              <option value={langUrls[code]} selected={lang === code}>{label}</option>
            ))}
          </select>
          <a class="btn btn-primary header-cta" href={copy.download.stablePath} data-download-kind="manual" data-download-channel="stable" data-beta-redirect={copy.download.betaPath}>{copy.footer.primaryCta}</a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-shell">
        <div class="footer-intro">
          <strong>{copy.meta.siteName}</strong>
          <h2>{copy.footer.slogan}</h2>
        </div>

        <div class="footer-links">
          <div>
            <h3>{copy.nav.download}</h3>
            <a href={`${homePath}download`}>{copy.nav.download}</a>
            <a href={`${homePath}pricing`}>{copy.nav.pricing}</a>
            <a href={`${homePath}guide`}>{copy.nav.guide}</a>
          </div>
          <div>
            <h3>{copy.footer.legal}</h3>
            <a href={`${homePath}privacy`}>{copy.footer.privacy}</a>
            <a href={`${homePath}terms`}>{copy.footer.terms}</a>
            <a href={`${homePath}changelog`}>{copy.nav.changelog}</a>
          </div>
          <div>
            <h3>{copy.footer.contact}</h3>
            <a href={`mailto:${copy.meta.supportEmail}`}>{copy.footer.contact}</a>
          </div>
        </div>
      </div>

      <div class="container footer-bottom">
        <p>&copy; 2026 {copy.footer.rights}</p>
      </div>
    </footer>
  </body>
</html>
