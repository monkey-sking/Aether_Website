---
import AetherMarketingPage from "../../components/AetherMarketingPage.astro";
import { languages } from "../../i18n/ui";

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== "en")
    .map((lang) => ({ params: { lang } }));
}
---

<AetherMarketingPage page="download" />
