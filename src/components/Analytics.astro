---
// Analytics.astro
// Replace the ID placeholders below with your actual Property IDs.
// 如果不想启用某项，留空或注释掉即可。

const GOOGLE_ID = "G-NWZD5W06VL"; // e.g., G-XXXXXXXXXX
const BAIDU_ID = "e5593846ee1e0a9809881f8067fe0483";  // e.g., 57e94d016...
const CLARITY_ID = "vy4ovpki3y"; // e.g., k8y...
const CF_BEACON_ID = ""; // e.g., your-cf-beacon-id

const isProd = import.meta.env.PROD; // Only run in production build
---

{isProd && (
  <script is:inline define:vars={{ GOOGLE_ID, BAIDU_ID, CLARITY_ID, CF_BEACON_ID }}>
    (function() {
      // 仅在正式生产域名下加载统计脚本，过滤本地测试 (localhost / 127.0.0.1) 及预览/测试部署环境
      var host = window.location.hostname;
      var isProduction = host === 'aether.7caifei.com' || host === 'www.aether.7caifei.com';

      // 准备好基础全局对象与空函数，避免非生产环境下业务代码调用 window.gtag / _hmt / clarity 报错
      window.dataLayer = window.dataLayer || [];
      if (!window.gtag) {
        window.gtag = function() {
          window.dataLayer.push(arguments);
        };
      }
      window._hmt = window._hmt || [];
      if (!window.clarity) {
        window.clarity = function() {
          (window.clarity.q = window.clarity.q || []).push(arguments);
        };
      }

      if (!isProduction) {
        return;
      }

      // 1. Google Analytics
      if (GOOGLE_ID) {
        window.gtag('js', new Date());
        window.gtag('config', GOOGLE_ID);

        var gaScript = document.createElement('script');
        gaScript.async = true;
        gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + GOOGLE_ID;
        document.head.appendChild(gaScript);
      }

      // 2. 百度统计
      if (BAIDU_ID) {
        var hm = document.createElement('script');
        hm.src = 'https://hm.baidu.com/hm.js?' + BAIDU_ID;
        hm.defer = true;
        var s = document.getElementsByTagName('script')[0];
        if (s && s.parentNode) {
          s.parentNode.insertBefore(hm, s);
        } else {
          document.head.appendChild(hm);
        }
      }

      // 3. Microsoft Clarity
      if (CLARITY_ID) {
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];
          if (y && y.parentNode) {
            y.parentNode.insertBefore(t,y);
          } else {
            document.head.appendChild(t);
          }
        })(window, document, "clarity", "script", CLARITY_ID);
      }

      // 4. Cloudflare Web Analytics Beacon
      if (CF_BEACON_ID) {
        var cfScript = document.createElement('script');
        cfScript.defer = true;
        cfScript.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        cfScript.setAttribute('data-cf-beacon', JSON.stringify({ token: CF_BEACON_ID }));
        document.head.appendChild(cfScript);
      }
    })();
  </script>
)}

<script is:inline>
  const stableRedirectModal = (() => {
    const overlay = document.createElement("div");
    overlay.className = "download-redirect-modal";
    overlay.hidden = true;
    overlay.innerHTML = `
      <div class="download-redirect-backdrop" data-modal-close></div>
      <div class="download-redirect-panel" role="dialog" aria-modal="true" aria-labelledby="download-redirect-title">
        <h2 id="download-redirect-title"></h2>
        <p class="download-redirect-body"></p>
        <div class="download-redirect-actions">
          <button type="button" class="download-redirect-secondary" data-modal-cancel></button>
          <button type="button" class="download-redirect-primary" data-modal-confirm></button>
        </div>
      </div>
    `;

    const style = document.createElement("style");
    style.textContent = `
      .download-redirect-modal[hidden] { display: none; }
      .download-redirect-modal {
        position: fixed;
        inset: 0;
        z-index: 1200;
      }
      .download-redirect-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(3, 8, 16, 0.68);
        backdrop-filter: blur(8px);
      }
      .download-redirect-panel {
        position: absolute;
        top: 50%;
        left: 50%;
        width: min(480px, calc(100vw - 32px));
        transform: translate(-50%, -50%);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: linear-gradient(180deg, rgba(11, 20, 34, 0.96), rgba(9, 17, 29, 0.98));
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.42);
        padding: 28px 24px 22px;
        color: #eef5ff;
      }
      .download-redirect-panel h2 {
        margin: 0 0 10px;
        font-size: 1.35rem;
        line-height: 1.2;
      }
      .download-redirect-body {
        margin: 0;
        color: rgba(220, 232, 248, 0.78);
      }
      .download-redirect-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 22px;
      }
      .download-redirect-actions button {
        border: 0;
        border-radius: 999px;
        min-height: 44px;
        padding: 0 18px;
        font: inherit;
        cursor: pointer;
      }
      .download-redirect-secondary {
        background: rgba(255, 255, 255, 0.08);
        color: rgba(238, 245, 255, 0.88);
      }
      .download-redirect-primary {
        background: linear-gradient(135deg, #6ce7ff, #8ea6ff);
        color: #04101d;
        font-weight: 700;
      }
      @media (max-width: 640px) {
        .download-redirect-panel {
          padding: 24px 18px 18px;
        }
        .download-redirect-actions {
          flex-direction: column-reverse;
        }
        .download-redirect-actions button {
          width: 100%;
        }
      }
    `;

    document.head.appendChild(style);
    document.body.appendChild(overlay);

    const title = overlay.querySelector("#download-redirect-title");
    const body = overlay.querySelector(".download-redirect-body");
    const cancelButton = overlay.querySelector("[data-modal-cancel]");
    const confirmButton = overlay.querySelector("[data-modal-confirm]");
    const closers = overlay.querySelectorAll("[data-modal-close], [data-modal-cancel]");
    let resolver = null;

    const close = (accepted) => {
      overlay.hidden = true;
      document.body.style.removeProperty("overflow");
      if (resolver) resolver(accepted);
      resolver = null;
    };

    closers.forEach((element) => {
      element.addEventListener("click", () => close(false));
    });
    confirmButton.addEventListener("click", () => close(true));
    document.addEventListener("keydown", (event) => {
      if (!overlay.hidden && event.key === "Escape") {
        close(false);
      }
    });

    return ({ heading, message, cancelLabel, confirmLabel }) => {
      title.textContent = heading;
      body.textContent = message;
      cancelButton.textContent = cancelLabel;
      confirmButton.textContent = confirmLabel;
      overlay.hidden = false;
      document.body.style.overflow = "hidden";
      confirmButton.focus();
      return new Promise((resolve) => {
        resolver = resolve;
      });
    };
  })();

  document.addEventListener("click", (event) => {
    const anchor = event.target instanceof Element ? event.target.closest("a[data-download-kind]") : null;
    if (!(anchor instanceof HTMLAnchorElement)) return;

    const kind = anchor.dataset.downloadKind || "manual";
    const channel = anchor.dataset.downloadChannel || "unknown";
    const href = anchor.getAttribute("href") || "";
    const eventName = `download_${kind}_${channel}`;
    const path = window.location.pathname || "/";
    const lang = path.startsWith("/zh-hans") ? "zh-hans" : "en";

    if (typeof window.gtag === "function") {
      window.gtag("event", eventName, {
        event_category: "download",
        event_label: href,
        channel,
        kind,
      });
    }

    if (Array.isArray(window._hmt)) {
      window._hmt.push(["_trackEvent", "download", eventName, href]);
    }

    if (typeof window.clarity === "function") {
      window.clarity("event", eventName);
    }
  });
</script>
